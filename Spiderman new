local stopCrawl, stopWebHang, stopWebWings, stopWebShield, playFlipAnimation -- Forward declarations

local function stopWebSwing(applyReleaseBoost)
	if not State.IsSwinging then
		return
	end
	State.IsSwinging = false
	SwingMaid:Clean()

	State.SwingRope = nil
	State.SwingForce = nil
	State.SwingAlign = nil
	State.SwingWorldAttachment = nil
	State.SwingRootAttachment = nil
	State.SwingWebBeam = nil
	State.SwingOuterBeam = nil

	if AnimationTracks.Swing and AnimationTracks.Swing.IsPlaying then
		AnimationTracks.Swing:Stop(0.18)
	end

	if Humanoid then
		pcall(function()
			Humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		end)
		Humanoid.AutoRotate = true
		Humanoid.PlatformStand = false
	end

	if applyReleaseBoost and RootPart then
		local vel = RootPart.AssemblyLinearVelocity
		local speed = vel.Magnitude

		-- Airborne check via downward ray (FloorMaterial is unreliable in Physics state)
		local params = getRayParams()
		local groundHit = Workspace:Raycast(RootPart.Position, Vector3.new(0, -7, 0), params)
		local isAirborne = (groundHit == nil)

		if isAirborne and Camera then
			-- SM2 release: momentum 100% preserved + a forward/up pop so swings chain fluidly
			local flatVel = Vector3.new(vel.X, 0, vel.Z)
			local camLook = Camera.CFrame.LookVector
			local launchDir = flatVel.Magnitude > 8
				and safeUnit(flatVel)
				or safeUnit(Vector3.new(camLook.X, 0, camLook.Z), RootPart.CFrame.LookVector)

			local momentumScale = clamp(speed / 60, 0.6, 1.4)
			local newVel = vel * CONFIG.Swing.ReleaseSpeedMultiplier
				+ launchDir * (CONFIG.Swing.ReleaseForwardImpulse * momentumScale)
				+ Vector3.new(0, CONFIG.Swing.ReleaseUpwardImpulse * clamp(momentumScale, 0.75, 1.25), 0)

			if newVel.Y < 22 then
				newVel = Vector3.new(newVel.X, 22, newVel.Z)
			end
			if newVel.Magnitude > CONFIG.Swing.MaxSwingSpeed then
				newVel = newVel.Unit * CONFIG.Swing.MaxSwingSpeed
			end
			RootPart.AssemblyLinearVelocity = newVel

			State.HasDoubleJumped = false
			playSound("Whoosh", 1.08, 0.06)
			playFlipAnimation(0.68)
		else
			-- Grounded release: keep rolling momentum, no pop
			State.HasDoubleJumped = false
		end
	end

	if State.ActiveMode == "Swinging" then
		State.ActiveMode = "Normal"
	end
	updateButtonHighlight("Swing", false)
end

local function startWebSwing()
	if not RootPart or not Humanoid or Humanoid.Health <= 0 or not Camera then
		return
	end
	if State.IsSwinging then
		return
	end
	if State.WebFluid < 4 then
		return
	end

	if State.IsCrawling then
		stopCrawl(false)
	end
	if State.IsHanging then
		stopWebHang()
	end
	if State.IsGliding then
		stopWebWings()
	end
	if State.IsShielding then
		stopWebShield()
	end

	local anchorPos, isFreeAir = findBestSwingAnchor()
	if not anchorPos then
		return
	end

	if AnimationTracks.Flip and AnimationTracks.Flip.IsPlaying then
		AnimationTracks.Flip:Stop(0.1)
	end
	State.IsFlipping = false

	-- Hop launch if starting from the ground (preserves movement input)
	if Humanoid.FloorMaterial ~= Enum.Material.Air then
		local desiredDir = getDesiredSwingHorizontalDirection()
		RootPart.AssemblyLinearVelocity = RootPart.AssemblyLinearVelocity
			+ desiredDir * 24
			+ Vector3.new(0, 30, 0)
	end

	State.IsSwinging = true
	State.SwingStartTime = os.clock()
	State.ActiveMode = "Swinging"
	State.SwingAnchorPos = anchorPos
	State.SwingIsFreeAir = isFreeAir
	State.AlternateWrist = not State.AlternateWrist
	State.SwingWrist = State.AlternateWrist and "Right" or "Left"

	local wristAtt = WebShooterAttachments[State.SwingWrist]
	spawnWristMuzzleBurst(wristAtt)
	playSound(State.AlternateWrist and "WebShoot" or "WebShootAlt", 1.0, 0.07)

	if not isFreeAir then
		spawnRadialWebSplat(anchorPos, Vector3.new(0, -1, 0), 2.4, 4.5)
	end

	local worldAtt = Instance.new("Attachment")
	worldAtt.Name = "SpiderSwingWorldAnchor"
	worldAtt.WorldPosition = anchorPos
	worldAtt.Parent = Workspace.Terrain
	SwingMaid:Give(worldAtt)
	State.SwingWorldAttachment = worldAtt

	local rootAtt = Instance.new("Attachment")
	rootAtt.Name = "SpiderSwingRootAttachment"
	rootAtt.Position = Vector3.new(0, 1.35, 0)
	rootAtt.Parent = RootPart
	SwingMaid:Give(rootAtt)
	State.SwingRootAttachment = rootAtt

	-- Rope length with ground-clearance safety
	local initialDist = (anchorPos - rootAtt.WorldPosition).Magnitude
	local desiredLen = clamp(initialDist * 0.96, CONFIG.Swing.MinRopeLength, CONFIG.Swing.MaxRopeLength)
	local groundBelowAnchor = Workspace:Raycast(
		anchorPos,
		Vector3.new(0, -(desiredLen + 25), 0),
		getRayParams()
	)
	if groundBelowAnchor then
		local maxSafeRope = (anchorPos.Y - groundBelowAnchor.Position.Y) - CONFIG.Swing.GroundClearanceBuffer
		if maxSafeRope >= CONFIG.Swing.MinRopeLength then
			desiredLen = math.min(desiredLen, maxSafeRope)
		end
	end
	State.SwingTargetRopeLength = desiredLen

	local rope = Instance.new("RopeConstraint")
	rope.Name = "SpiderSwingRope"
	rope.Attachment0 = rootAtt
	rope.Attachment1 = worldAtt
	rope.Length = initialDist
	rope.Restitution = CONFIG.Swing.RopeRestitution
	rope.Visible = false
	rope.Enabled = true
	rope.Parent = RootPart
	SwingMaid:Give(rope)
	State.SwingRope = rope

	local vForce = Instance.new("VectorForce")
	vForce.Name = "SpiderSwingPendulumForce"
	vForce.Attachment0 = rootAtt
	vForce.RelativeTo = Enum.ActuatorRelativeTo.World
	vForce.Force = Vector3.new(0, 0, 0)
	vForce.Parent = RootPart
	SwingMaid:Give(vForce)
	State.SwingForce = vForce

	local align = Instance.new("AlignOrientation")
	align.Name = "SpiderSwingAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = rootAtt
	align.Responsiveness = CONFIG.Swing.OrientationResponsiveness
	align.MaxTorque = 135000
	align.CFrame = RootPart.CFrame
	align.Parent = RootPart
	SwingMaid:Give(align)
	State.SwingAlign = align

	local beamSourceAtt = wristAtt or rootAtt
	local webFolder, mainBeam, outerBeam = createWebTextureBeam(
		beamSourceAtt,
		worldAtt,
		0.15,
		0.24,
		Color3.fromRGB(245, 248, 255)
	)
	SwingMaid:Give(webFolder)
	State.SwingWebBeam = mainBeam
	State.SwingOuterBeam = outerBeam

	Humanoid.AutoRotate = false
	pcall(function()
		Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end)

	-- SM2 CATCH: redirect current momentum onto the swing tangent, converting dive speed into arc speed
	local vel = RootPart.AssemblyLinearVelocity
	local ropeDir = safeUnit(anchorPos - RootPart.Position, Vector3.new(0, 1, 0))
	local radial = vel:Dot(ropeDir)
	local tangentVel = vel - ropeDir * radial
	local flatDesired = getDesiredSwingHorizontalDirection()
	local dirOut = tangentVel.Magnitude > 1.5 and tangentVel.Unit or flatDesired
	local newSpeed = math.max(tangentVel.Magnitude, 14)
	newSpeed = math.min(
		newSpeed + math.max(0, -vel.Y) * CONFIG.Swing.DiveRedirectBoost,
		CONFIG.Swing.MaxSwingSpeed
	)
	RootPart.AssemblyLinearVelocity = dirOut * newSpeed

	if AnimationTracks.Swing then
		AnimationTracks.Swing:Play(0.16, 1, 1.0)
	end

	updateButtonHighlight("Swing", true)
end

local function stepWebSwing(dt)
	if not State.IsSwinging or not RootPart or not Humanoid or not Camera then
		return
	end

	if not consumeWebFluid(CONFIG.WebFluid.SwingDrainPerSec * dt) then
		stopWebSwing(true)
		return
	end

	local rope = State.SwingRope
	local vForce = State.SwingForce
	local align = State.SwingAlign
	if not rope or not vForce or not align then
		stopWebSwing(false)
		return
	end

	-- Keep the humanoid in full Physics state: zero artificial air damping, pure gravity pendulum
	if Humanoid:GetState() ~= Enum.HumanoidStateType.Physics then
		pcall(function()
			Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		end)
	end

	local rootPos = RootPart.Position
	local anchorPos = State.SwingAnchorPos
	local toAnchor = anchorPos - rootPos
	local dist = toAnchor.Magnitude
	local ropeDir = safeUnit(toAnchor, Vector3.new(0, 1, 0))

	-- Web shoot-out whip visual on the first 0.14s
	local shootElapsed = os.clock() - State.SwingStartTime
	if State.SwingOuterBeam then
		if shootElapsed < 0.14 then
			local whip = (1 - (shootElapsed / 0.14)) * 2.2
			State.SwingOuterBeam.CurveSize0 = math.sin(shootElapsed * 60) * whip
			State.SwingOuterBeam.CurveSize1 = -math.cos(shootElapsed * 60) * whip
		else
			State.SwingOuterBeam.CurveSize0 = 0.08
			State.SwingOuterBeam.CurveSize1 = -0.08
		end
	end

	-- 1. Rope Reeling (W = reel up = faster, S = let out) + automatic slack take-up
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		State.SwingTargetRopeLength = clamp(
			State.SwingTargetRopeLength - CONFIG.Swing.ReelSpeed * dt,
			CONFIG.Swing.MinRopeLength,
			CONFIG.Swing.MaxRopeLength
		)
	elseif UserInputService:IsKeyDown(Enum.KeyCode.S) then
		State.SwingTargetRopeLength = clamp(
			State.SwingTargetRopeLength + CONFIG.Swing.ReelSpeed * dt,
			CONFIG.Swing.MinRopeLength,
			CONFIG.Swing.MaxRopeLength
		)
	end
	if dist < State.SwingTargetRopeLength - 2 then
		State.SwingTargetRopeLength = clamp(
			lerp(State.SwingTargetRopeLength, dist, clamp(dt * 4, 0, 1)),
			CONFIG.Swing.MinRopeLength,
			CONFIG.Swing.MaxRopeLength
		)
	end
	rope.Length = lerp(rope.Length, State.SwingTargetRopeLength, clamp(dt * 10, 0, 1))

	local vel = RootPart.AssemblyLinearVelocity
	local speed = vel.Magnitude
	local moveDir = Humanoid.MoveDirection
	local camLook = Camera.CFrame.LookVector
	local camFlat = safeUnit(Vector3.new(camLook.X, 0, camLook.Z), RootPart.CFrame.LookVector)
	local hasInput = moveDir.Magnitude > 0.08
	local inputFlat = hasInput and safeUnit(Vector3.new(moveDir.X, 0, moveDir.Z), camFlat) or camFlat

	-- 2. TAUT-ROPE MOMENTUM PRESERVER:
	-- When the rope pulls taut against outward/downward motion, redirect that radial energy
	-- into tangential speed instead of letting the constraint brake the player.
	local radial = vel:Dot(ropeDir)
	if dist >= rope.Length - 1.2 and radial < -1.5 then
		local tangentVel = vel - ropeDir * radial
		local dirOut = tangentVel.Magnitude > 1.5 and tangentVel.Unit or inputFlat
		local keepSpeed = math.max(tangentVel.Magnitude, 8)
		keepSpeed = math.min(keepSpeed, CONFIG.Swing.MaxSwingSpeed)
		vel = dirOut * keepSpeed
		RootPart.AssemblyLinearVelocity = vel
		radial = vel:Dot(ropeDir)
	end

	-- 3. OMNIDIRECTIONAL VELOCITY CARVING:
	-- Rotate the horizontal velocity toward the desired direction at a fixed turn rate.
	-- Magnitude is fully preserved — steering never slows Spider-Man down.
	local flatVel = Vector3.new(vel.X, 0, vel.Z)
	if flatVel.Magnitude > 3 then
		local flatDir = flatVel.Unit
		local turnRate = hasInput and CONFIG.Swing.VelocityTurnRate or CONFIG.Swing.IdleTurnRate
		local blended = flatDir:Lerp(inputFlat, clamp(turnRate * dt, 0, 1))
		if blended.Magnitude > 0.001 then
			blended = blended.Unit
			local flatSpeed = flatVel.Magnitude
			vel = Vector3.new(blended.X * flatSpeed, vel.Y, blended.Z * flatSpeed)
			RootPart.AssemblyLinearVelocity = vel
		end
	end

	speed = vel.Magnitude

	-- 4. PENDULUM FORCE SYNTHESIS (natural gravity does the core work; these add SM2 punch)
	local mass = RootPart.AssemblyMass
	local g = Workspace.Gravity
	local cosT = clamp(ropeDir.Y, -1, 1) -- 1.0 at the very bottom of the arc
	local sinT = math.sqrt(clamp(1 - cosT * cosT, 0, 1))
	local travel = safeUnit(inputFlat - ropeDir * inputFlat:Dot(ropeDir), camFlat)

	local force = Vector3.new(0, 0, 0)

	-- PHASE A — Downswing: strong acceleration while diving into the arc
	if vel.Y < -1 then
		local intensity = clamp(-vel.Y / 48, 0.25, 1.5)
		force = force + travel * (CONFIG.Swing.DownswingDriveForce * intensity)
	end

	-- PHASE B — Bottom of arc: massive momentum whip through perigee
	if cosT > 0.7 then
		local a = clamp((cosT - 0.7) / 0.3, 0, 1)
		local whip = math.sin(a * math.pi * 0.5)
		force = force
			+ travel * (CONFIG.Swing.BottomArcWhipForce * whip * clamp(speed / 40, 0.7, 1.5))
	end

	-- PHASE C — Upswing: carry bottom-of-arc speed smoothly upward, fighting air damping
	if vel.Y >= -1 then
		local a = clamp(sinT * 1.25, 0.25, 1)
		force = force + travel * (CONFIG.Swing.UpswingCarryForce * a)
		force = force + Vector3.new(0, g * mass * CONFIG.Swing.UpswingLiftFraction * a, 0)
	end

	-- Omnidirectional input thrust on the tangent plane (forward, backward, sideways, diagonal)
	if hasInput then
		local inputTangent = safeUnit(inputFlat - ropeDir * inputFlat:Dot(ropeDir), travel)
		force = force + inputTangent * CONFIG.Swing.SteerInputForce
	end

	-- 5. GROUND SKIMMING: smooth lift curve instead of scraping
	local groundHit = Workspace:Raycast(
		rootPos,
		Vector3.new(0, -(CONFIG.Swing.GroundClearanceBuffer + 6), 0),
		getRayParams()
	)
	if groundHit then
		local height = rootPos.Y - groundHit.Position.Y
		if height < CONFIG.Swing.GroundClearanceBuffer then
			local urgency = clamp(1 - (height / CONFIG.Swing.GroundClearanceBuffer), 0, 1)
			force = force
				+ Vector3.new(0, g * mass * CONFIG.Swing.GroundSkimLift * (0.4 + urgency), 0)
			if vel.Y < 0 then
				local newY = lerp(vel.Y, 2, clamp(dt * 16, 0, 1))
				local skimVel = Vector3.new(vel.X, newY, vel.Z)
				if skimVel.Magnitude > 1 then
					skimVel = skimVel.Unit * speed
				end
				RootPart.AssemblyLinearVelocity = skimVel
				vel = skimVel
			end
		end
	end

	-- 6. Gentle aerodynamic drag (keeps terminal feel physical, never sticky)
	force = force - vel * speed * CONFIG.Swing.AirDragCoeff
	vForce.Force = force

	-- 7. Soft terminal ceiling (no hard snap)
	local currentVel = RootPart.AssemblyLinearVelocity
	if currentVel.Magnitude > CONFIG.Swing.MaxSwingSpeed then
		local cappedSpeed = lerp(currentVel.Magnitude, CONFIG.Swing.MaxSwingSpeed, clamp(dt * 4, 0, 1))
		RootPart.AssemblyLinearVelocity = currentVel.Unit * cappedSpeed
	end

	-- 8. Web-connected body orientation & banking
	local finalVel = RootPart.AssemblyLinearVelocity
	local lookDir = finalVel.Magnitude > 6 and safeUnit(finalVel, travel) or travel
	local pendulumUp = safeUnit(ropeDir * 0.82 + Vector3.new(0, 0.18, 0), Vector3.new(0, 1, 0))
	local lateralInput = hasInput and inputFlat:Dot(Camera.CFrame.RightVector) or 0

	align.CFrame = CFrame.lookAt(rootPos, rootPos + lookDir, pendulumUp)
		* CFrame.Angles(0, 0, math.rad(-lateralInput * 18))
end

