	local linVel = Instance.new("LinearVelocity")
	linVel.Attachment0 = att
	linVel.RelativeTo = Enum.ActuatorRelativeTo.World
	linVel.MaxForce = 110000
	linVel.VectorVelocity = Camera.CFrame.LookVector * State.GlideSpeed
	linVel.Parent = RootPart
	WingsMaid:Give(linVel)
	State.GlideLinearVel = linVel

	local align = Instance.new("AlignOrientation")
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
