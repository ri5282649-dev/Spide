local lastSenseScan = 0

local function stepSpiderSense(dt)
	if not RootPart or not Head then
		return
	end
	local now = os.clock()
	if now - lastSenseScan >= CONFIG.SpiderSense.ScanInterval then
		lastSenseScan = now
		local foundThreat = false
		local bestSeverity = 0
		local bestPos = Vector3.new(0, 0, 0)

		local myVel = RootPart.AssemblyLinearVelocity
		if myVel.Magnitude > 58 then
			local hit = Workspace:Raycast(RootPart.Position, myVel.Unit * 22, getRayParams())
			if hit and hit.Instance and hit.Instance.CanCollide and not State.IsCrawling then
				foundThreat = true
				bestSeverity = 0.85
				bestPos = hit.Position
			end
		end

		local overlap = OverlapParams.new()
		overlap.FilterType = Enum.RaycastFilterType.Exclude
		overlap.FilterDescendantsInstances = Character and { Character } or {}
		local nearby = Workspace:GetPartBoundsInRadius(RootPart.Position, CONFIG.SpiderSense.ScanRadius, overlap)

		for _, part in ipairs(nearby) do
			if not part.Anchored then
				local pVel = part.AssemblyLinearVelocity
				if pVel.Magnitude > 26 then
					local toPlayer = RootPart.Position - part.Position
					local closingDot = safeUnit(pVel):Dot(safeUnit(toPlayer))
					if closingDot > 0.55 then
						foundThreat = true
						bestSeverity = 1.0
						bestPos = part.Position
						break
					end
				end
			end
		end

		State.ThreatDetected = foundThreat
		State.ThreatSeverity = bestSeverity
		State.ThreatPosition = bestPos
	end

	if SenseBannerFrame then
		SenseBannerFrame.Visible = State.ThreatDetected
	end

	local pulseAlpha = State.ThreatDetected and (0.15 + math.abs(math.sin(now * 16)) * 0.45) or 1
	local spikeColor = (math.floor(now * 14) % 2 == 0)
		and Color3.fromRGB(255, 55, 65)
		or Color3.fromRGB(255, 235, 90)
	for _, spike in ipairs(SenseSpikes) do
		spike.Transparency = lerp(spike.Transparency, pulseAlpha, clamp(dt * 14, 0, 1))
		spike.Color = spikeColor
	end
end

local function performSpiderSenseDodge()
	if not RootPart or not Humanoid or Humanoid.Health <= 0 then
		return
	end
	local now = os.clock()
	if now - State.LastDodgeTime < CONFIG.SpiderSense.DodgeCooldown then
		return
	end

	State.LastDodgeTime = now
	State.IsDodging = true
	State.DodgeStartTime = now
	updateButtonHighlight("SpiderSense", true)
	playSound("Swoosh", 1.18, 0.06)

	local dodgeDir
	if State.ThreatDetected and (State.ThreatPosition - RootPart.Position).Magnitude > 0.5 then
		local awayFromThreat = safeUnit(RootPart.Position - State.ThreatPosition, RootPart.CFrame.RightVector)
		local sideVec = safeUnit(awayFromThreat:Cross(Vector3.new(0, 1, 0)), RootPart.CFrame.RightVector)
		dodgeDir = safeUnit(awayFromThreat * 0.65 + sideVec * 0.75, RootPart.CFrame.RightVector)
	elseif Humanoid.MoveDirection.Magnitude > 0.1 then
		dodgeDir = Humanoid.MoveDirection.Unit
	else
		dodgeDir = -RootPart.CFrame.LookVector
	end

	State.DodgeDir = dodgeDir
	RootPart.AssemblyLinearVelocity = dodgeDir * CONFIG.SpiderSense.DodgeSpeed
		+ Vector3.new(0, CONFIG.SpiderSense.DodgeUpBoost, 0)

	playFlipAnimation(CONFIG.SpiderSense.DodgeDuration)
	spawnShockwaveRing(RootPart.Position, Vector3.new(0, 1, 0), 5.0, Color3.fromRGB(255, 85, 95), 0.25)

	task.delay(CONFIG.SpiderSense.DodgeDuration, function()
		State.IsDodging = false
		updateButtonHighlight("SpiderSense", false)
	end)
end

