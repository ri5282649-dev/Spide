TriggerAbility = function(abilityId, isPressed)
	if abilityId == "Swing" then
		if isPressed then
			startWebSwing()
		else
			stopWebSwing(true)
		end
	elseif abilityId == "Crawl" and isPressed then
		if State.IsCrawling then
			stopCrawl(false)
		else
			startCrawl()
		end
	elseif abilityId == "WebZip" and isPressed then
		startWebZip()
	elseif abilityId == "WebShoot" and isPressed then
		fireWebProjectile()
	elseif abilityId == "WebPull" and isPressed then
		performWebPull()
	elseif abilityId == "WebBomb" and isPressed then
		throwWebBomb()
	elseif abilityId == "WebShield" and isPressed then
		toggleWebShield()
	elseif abilityId == "SpiderSense" and isPressed then
		performSpiderSenseDodge()
	elseif abilityId == "SuperJump" then
		if isPressed then
			startJumpCharge()
		else
			releaseJumpCharge()
		end
	elseif abilityId == "Acrobatics" and isPressed then
		performAerialFlip()
	elseif abilityId == "WebHang" and isPressed then
		toggleWebHang()
	elseif abilityId == "WebWings" and isPressed then
		toggleWebWings()
	elseif abilityId == "Combat" and isPressed then
		performCombatCombo()
	elseif abilityId == "Cancel" and isPressed then
		cancelAllAbilities()
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	local kc = input.KeyCode
	if kc == CONFIG.Keybinds.Swing or kc == CONFIG.Keybinds.SwingAlt then
		TriggerAbility("Swing", true)
	elseif kc == CONFIG.Keybinds.Crawl then
		TriggerAbility("Crawl", true)
	elseif kc == CONFIG.Keybinds.WebZip then
		TriggerAbility("WebZip", true)
	elseif kc == CONFIG.Keybinds.WebShoot then
		TriggerAbility("WebShoot", true)
	elseif kc == CONFIG.Keybinds.WebPull then
		TriggerAbility("WebPull", true)
	elseif kc == CONFIG.Keybinds.WebBomb then
		TriggerAbility("WebBomb", true)
	elseif kc == CONFIG.Keybinds.WebShield then
		TriggerAbility("WebShield", true)
	elseif kc == CONFIG.Keybinds.SpiderSense then
		TriggerAbility("SpiderSense", true)
	elseif kc == CONFIG.Keybinds.Acrobatics then
		TriggerAbility("Acrobatics", true)
	elseif kc == CONFIG.Keybinds.WebHang then
		TriggerAbility("WebHang", true)
	elseif kc == CONFIG.Keybinds.WebWings then
		TriggerAbility("WebWings", true)
	elseif kc == CONFIG.Keybinds.Combat or input.UserInputType == Enum.UserInputType.MouseButton1 then
		TriggerAbility("Combat", true)
	elseif kc == CONFIG.Keybinds.CancelAll then
		TriggerAbility("Cancel", true)
	elseif kc == CONFIG.Keybinds.Sprint then
		State.IsSprinting = true
	elseif kc == CONFIG.Keybinds.SuperJump then
		if State.IsCrawling then
			stopCrawl(true)
		elseif State.IsSwinging then
			stopWebSwing(true)
		elseif State.IsHanging then
			stopWebHang()
		elseif Humanoid and Humanoid.FloorMaterial == Enum.Material.Air then
			if not State.HasDoubleJumped then
				State.HasDoubleJumped = true
				performAerialFlip()
			end
		else
			TriggerAbility("SuperJump", true)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input, _gameProcessed)
	local kc = input.KeyCode
	if kc == CONFIG.Keybinds.Swing or kc == CONFIG.Keybinds.SwingAlt then
		TriggerAbility("Swing", false)
	elseif kc == CONFIG.Keybinds.SuperJump then
		TriggerAbility("SuperJump", false)
	elseif kc == CONFIG.Keybinds.Sprint then
		State.IsSprinting = false
	end
end)

