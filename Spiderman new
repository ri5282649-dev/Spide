local Maid = {}
Maid.__index = Maid

function Maid.new()
	return setmetatable({ _tasks = {} }, Maid)
end

function Maid:Give(task)
	if task then
		table.insert(self._tasks, task)
	end
	return task
end

function Maid:Clean()
	for i = #self._tasks, 1, -1 do
		local task = self._tasks[i]
		self._tasks[i] = nil
		local tType = typeof(task)
		if tType == "RBXScriptConnection" then
			task:Disconnect()
		elseif tType == "Instance" then
			if task.Parent then
				task:Destroy()
			end
		elseif tType == "function" then
			pcall(task)
		elseif tType == "table" and type(task.Clean) == "function" then
			pcall(function()
				task:Clean()
			end)
		end
	end
end

local function clamp(val, minVal, maxVal)
	return math.max(minVal, math.min(maxVal, val))
end

local function lerp(a, b, t)
	return a + (b - a) * clamp(t, 0, 1)
end

local function safeUnit(v, fallback)
	if v.Magnitude > 1e-4 then
		return v.Unit
	end
	return fallback or Vector3.new(0, 0, -1)
end

