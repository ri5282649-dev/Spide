Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	Camera = Workspace.CurrentCamera
end)

RunService.Stepped:Connect(function(_time, dt)
	stepProceduralPose(dt)
end)

RunService.Heartbeat:Connect(function(dt)
	Camera = Workspace.CurrentCamera or Camera
	if not Character or not Humanoid or Humanoid.Health <= 0 then
		return
	end

	if State.IsSwinging then
		stepWebSwing(dt)
	end
	if State.IsCrawling then
		stepCrawl(dt)
	end
	if State.IsHanging then
		stepWebHang(dt)
	end
	if State.IsGliding then
		stepWebWings(dt)
	end
	if State.IsShielding then
		if not consumeWebFluid(CONFIG.WebFluid.WebShieldDrainPerSec * dt) then
			stopWebShield()
		end
	end

	stepSpiderSense(dt)
end)

RunService.RenderStepped:Connect(function(dt)
	stepCameraAndHUD(dt)
end)
