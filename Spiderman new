	end
	if isActive then
		entry.Button.BackgroundColor3 = Color3.fromRGB(195, 38, 54)
		entry.Stroke.Color = Color3.fromRGB(255, 235, 120)
	else
		entry.Button.BackgroundColor3 = Color3.fromRGB(18, 23, 36)
		entry.Stroke.Color = Color3.fromRGB(215, 45, 62)
	end
end

local function consumeWebFluid(amount)
	if State.WebFluid < amount then
		return false
	end
	State.WebFluid = clamp(State.WebFluid - amount, 0, CONFIG.WebFluid.Max)
	return true
end

