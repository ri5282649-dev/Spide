local function detectCrawlSurface()
	if not RootPart then
		return nil, nil
	end
	local params = getRayParams()
	local cf = RootPart.CFrame
	local origin = cf.Position
	local dist = CONFIG.Crawl.DetectDistance

	local dirs = {
		cf.LookVector * dist,
		safeUnit(cf.LookVector - cf.UpVector * 0.7) * dist,
		-State.CrawlNormal * dist,
		-cf.UpVector * dist,
		cf.UpVector * dist,
		cf.RightVector * dist,
		-cf.RightVector * dist,
	}

	for _, d in ipairs(dirs) do
		local hit = Workspace:Raycast(origin, d, params)
		if hit and hit.Instance and hit.Instance.CanCollide then
			if hit.Normal.Y < 0.82 then
				return hit.Position, hit.Normal
			end
		end
	end

	local stepOrigin = origin + cf.LookVector * 2.5 - cf.UpVector * 1.2
	local wrapHit = Workspace:Raycast(stepOrigin, -cf.LookVector * 4.5, params)
	if wrapHit and wrapHit.Instance and wrapHit.Instance.CanCollide and wrapHit.Normal.Y < 0.82 then
		return wrapHit.Position, wrapHit.Normal
	end

	return nil, nil
end

stopCrawl = function(doWallJump)
	if not State.IsCrawling then
		return
	end
	local jumpNormal = State.CrawlNormal
	State.IsCrawling = false
	CrawlMaid:Clean()

	State.CrawlLinearVel = nil
	State.CrawlAlign = nil
	State.CrawlAttachment = nil

	if AnimationTracks.Crawl and AnimationTracks.Crawl.IsPlaying then
		AnimationTracks.Crawl:Stop(0.2)
	end

	if Humanoid then
		Humanoid.AutoRotate = true
		Humanoid.PlatformStand = false
		pcall(function()
			Humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		end)
	end

	if doWallJump and RootPart then
		local boost = jumpNormal * CONFIG.Crawl.WallJumpNormalBoost
			+ Vector3.new(0, CONFIG.Crawl.WallJumpUpBoost, 0)
		RootPart.AssemblyLinearVelocity = boost
		State.HasDoubleJumped = false
		playSound("Whoosh", 1.12, 0.06)
		spawnShockwaveRing(RootPart.Position - jumpNormal * 1.5, jumpNormal, 5.5, Color3.fromRGB(235, 245, 255), 0.28)
		playFlipAnimation(0.65)
	end

	if State.ActiveMode == "Crawling" then
		State.ActiveMode = "Normal"
	end
	updateButtonHighlight("Crawl", false)
end

local function startCrawl()
	if not RootPart or not Humanoid or Humanoid.Health <= 0 then
		return
	end
	local hitPos, hitNormal = detectCrawlSurface()
	if not hitPos or not hitNormal then
		return
	end

	if State.IsSwinging then
		stopWebSwing(false)
	end
	if State.IsHanging then
		stopWebHang()
	end
	if State.IsGliding then
		stopWebWings()
	end

	State.IsCrawling = true
	State.ActiveMode = "Crawling"
	State.CrawlNormal = hitNormal

	Humanoid.AutoRotate = false
	Humanoid.PlatformStand = true

	if Animator then
		for _, track in ipairs(Animator:GetPlayingAnimationTracks()) do
			if track ~= AnimationTracks.Crawl then
				track:Stop(0.15)
			end
		end
	end

	local att = Instance.new("Attachment")
	att.Name = "SpiderCrawlAttachment"
	att.Parent = RootPart
	CrawlMaid:Give(att)
	State.CrawlAttachment = att

	local linVel = Instance.new("LinearVelocity")
	linVel.Name = "SpiderCrawlVelocity"
	linVel.Attachment0 = att
	linVel.RelativeTo = Enum.ActuatorRelativeTo.World
	linVel.MaxForce = 125000
	linVel.VectorVelocity = Vector3.new(0, 0, 0)
	linVel.Parent = RootPart
	CrawlMaid:Give(linVel)
	State.CrawlLinearVel = linVel

	local align = Instance.new("AlignOrientation")
	align.Name = "SpiderCrawlAlign"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.Responsiveness = CONFIG.Crawl.AlignResponsiveness
	align.MaxTorque = CONFIG.Crawl.AlignMaxTorque
	align.CFrame = RootPart.CFrame
	align.Parent = RootPart
	CrawlMaid:Give(align)
	State.CrawlAlign = align

	if AnimationTracks.Crawl then
		AnimationTracks.Crawl:Play(0.2, 1, 0)
	end

	updateButtonHighlight("Crawl", true)
end

local function stepCrawl(dt)
	if not State.IsCrawling or not RootPart or not Humanoid then
		return
	end

	local hitPos, hitNormal = detectCrawlSurface()
	if not hitPos or not hitNormal then
		stopCrawl(false)
		return
	end

	State.CrawlNormal = safeUnit(State.CrawlNormal:Lerp(hitNormal, clamp(dt * 14, 0, 1)), hitNormal)
	local normal = State.CrawlNormal

	local camCF = Camera.CFrame
	local rawInput = Humanoid.MoveDirection
	local moveTangent = Vector3.new(0, 0, 0)

	if rawInput.Magnitude > 0.05 then
		local camLookOnWall = camCF.LookVector - normal * camCF.LookVector:Dot(normal)
		local camRightOnWall = camCF.RightVector - normal * camCF.RightVector:Dot(normal)
		camLookOnWall = safeUnit(camLookOnWall, RootPart.CFrame.LookVector)
		camRightOnWall = safeUnit(camRightOnWall, RootPart.CFrame.RightVector)

		local flatCamLook = safeUnit(Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z))
		local flatCamRight = safeUnit(Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z))
		local forwardAmt = rawInput:Dot(flatCamLook)
		local rightAmt = rawInput:Dot(flatCamRight)

		moveTangent = safeUnit(camLookOnWall * forwardAmt + camRightOnWall * rightAmt, Vector3.new(0, 0, 0))
	end

	local desiredPos = hitPos + normal * CONFIG.Crawl.SurfaceSnapDistance
	local snapCorrection = (desiredPos - RootPart.Position) * 10

	if State.CrawlLinearVel then
		if moveTangent.Magnitude > 0.05 then
			State.CrawlLinearVel.VectorVelocity = moveTangent * CONFIG.Crawl.CrawlSpeed + snapCorrection
			if AnimationTracks.Crawl then
				AnimationTracks.Crawl:AdjustSpeed(1.25)
			end
		else
			State.CrawlLinearVel.VectorVelocity = snapCorrection
			if AnimationTracks.Crawl then
				AnimationTracks.Crawl:AdjustSpeed(0)
			end
		end
	end

	if State.CrawlAlign then
		local currentLook = RootPart.CFrame.LookVector
		local projectedLook = moveTangent.Magnitude > 0.05 and moveTangent
			or safeUnit(currentLook - normal * currentLook:Dot(normal), Vector3.new(0, 1, 0))
		local rightVec = safeUnit(projectedLook:Cross(normal), Vector3.new(1, 0, 0))
		local correctedForward = safeUnit(normal:Cross(rightVec), projectedLook)
		State.CrawlAlign.CFrame = CFrame.fromMatrix(RootPart.Position, rightVec, normal, -correctedForward)
	end
end

