playFlipAnimation = function(duration)
	duration = duration or 0.65
	State.IsFlipping = true
	State.FlipStartTime = os.clock()
	State.FlipDuration = duration
	State.FlipStyle = (State.FlipStyle % 5) + 1

	if AnimationTracks.Flip then
		AnimationTracks.Flip:Stop(0.05)
		AnimationTracks.Flip:Play(0.08, 1, 1.15)
		if AnimationTracks.Flip.Length > 0 then
			AnimationTracks.Flip:AdjustSpeed(clamp(AnimationTracks.Flip.Length / duration, 0.85, 1.85))
		end
	end

	local capturedStart = State.FlipStartTime
	task.delay(duration, function()
		if State.FlipStartTime == capturedStart then
			State.IsFlipping = false
			if AnimationTracks.Flip and AnimationTracks.Flip.IsPlaying then
				AnimationTracks.Flip:Stop(0.15)
			end
			updateButtonHighlight("Acrobatics", false)
		end
	end)
end

local function startJumpCharge()
	if not Humanoid or not RootPart then
		return
	end
	if State.IsSwinging or State.IsCrawling or State.IsHanging or State.IsGliding then
		return
	end
	State.IsChargingJump = true
	State.JumpChargeStart = os.clock()
	State.JumpChargeAlpha = 0
	updateButtonHighlight("SuperJump", true)
end

local function releaseJumpCharge()
	if not State.IsChargingJump then
		return
	end
	State.IsChargingJump = false
	updateButtonHighlight("SuperJump", false)
	if JumpChargeFill then
		JumpChargeFill.Size = UDim2.new(0, 0, 1, 0)
	end

	if not Humanoid or not RootPart then
		return
	end
	local chargeTime = os.clock() - State.JumpChargeStart
	local alpha = clamp(chargeTime / CONFIG.Strength.SuperJumpMaxChargeTime, 0, 1)

	if Humanoid.FloorMaterial ~= Enum.Material.Air and alpha >= 0.22 then
		local upVel = lerp(CONFIG.Strength.SuperJumpMinBoost, CONFIG.Strength.SuperJumpMaxBoost, alpha)
		local forwardVel = RootPart.CFrame.LookVector * (24 * alpha)
		RootPart.AssemblyLinearVelocity = Vector3.new(
			RootPart.AssemblyLinearVelocity.X + forwardVel.X,
			upVel,
			RootPart.AssemblyLinearVelocity.Z + forwardVel.Z
		)
		State.HasDoubleJumped = false
		playSound("Whoosh", 0.92, 0.05)
		spawnShockwaveRing(
			RootPart.Position - Vector3.new(0, 2.6, 0),
			Vector3.new(0, 1, 0),
			9.5 * alpha + 4,
			Color3.fromRGB(245, 248, 255),
			0.36
		)
		playFlipAnimation(0.68)
	end
	State.JumpChargeAlpha = 0
end

local function performAerialFlip()
	if not RootPart or not Humanoid or Humanoid.Health <= 0 then
		return
	end
	updateButtonHighlight("Acrobatics", true)
	playSound("Swoosh", 1.08, 0.08)

	if Humanoid.FloorMaterial ~= Enum.Material.Air then
		RootPart.AssemblyLinearVelocity = RootPart.AssemblyLinearVelocity
			+ Vector3.new(0, 52, 0)
			+ RootPart.CFrame.LookVector * 22
	else
		RootPart.AssemblyLinearVelocity = RootPart.AssemblyLinearVelocity + Vector3.new(0, 22, 0)
	end

	playFlipAnimation(0.65)
end

