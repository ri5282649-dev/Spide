local function spawnRadialWebSplat(position, normal, radius, duration)
	radius = radius or 3.2
	duration = duration or 6.0
	local upVec = math.abs(normal.Y) > 0.95 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local baseCF = CFrame.lookAt(position + normal * 0.05, position + normal * 1.05, upVec)

	local folder = Instance.new("Folder")
	folder.Name = "SpiderWebSplat"
	folder.Parent = Workspace

	local spokes = 8
	for i = 1, spokes do
		local angle = (i / spokes) * math.pi * 2
		local spoke = Instance.new("Part")
		spoke.Size = Vector3.new(0.08, 0.04, radius * 2)
		spoke.Anchored = true
		spoke.CanCollide = false
		spoke.CanQuery = false
		spoke.CanTouch = false
		spoke.Material = Enum.Material.SmoothPlastic
		spoke.Color = Color3.fromRGB(242, 246, 255)
		spoke.Transparency = 0.15
		spoke.CFrame = baseCF * CFrame.Angles(0, 0, angle) * CFrame.Angles(math.rad(90), 0, 0)
		spoke.Parent = folder
	end

	for r = 1, 2 do
		local ringRadius = radius * (r / 2.2)
		for i = 1, spokes do
			local a1 = (i / spokes) * math.pi * 2
			local a2 = ((i + 1) / spokes) * math.pi * 2
			local p1 = (baseCF * CFrame.new(math.cos(a1) * ringRadius, math.sin(a1) * ringRadius, 0)).Position
			local p2 = (baseCF * CFrame.new(math.cos(a2) * ringRadius, math.sin(a2) * ringRadius, 0)).Position
			local segLen = (p2 - p1).Magnitude
			local seg = Instance.new("Part")
			seg.Size = Vector3.new(0.06, 0.04, segLen)
			seg.Anchored = true
			seg.CanCollide = false
			seg.CanQuery = false
			seg.CanTouch = false
			seg.Material = Enum.Material.SmoothPlastic
			seg.Color = Color3.fromRGB(235, 242, 255)
			seg.Transparency = 0.2
			seg.CFrame = CFrame.lookAt((p1 + p2) * 0.5, p2, normal)
			seg.Parent = folder
		end
	end

	task.delay(duration - 0.6, function()
		if folder and folder.Parent then
			for _, child in ipairs(folder:GetChildren()) do
				if child:IsA("BasePart") then
					TweenService:Create(child, TweenInfo.new(0.55), { Transparency = 1 }):Play()
				end
			end
		end
	end)
	Debris:AddItem(folder, duration)
end

