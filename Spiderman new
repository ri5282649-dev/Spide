			ZipMaid:Clean()
			if RootPart then
				RootPart.AssemblyLinearVelocity = zipDir * 44 + Vector3.new(0, CONFIG.WebZip.ArrivalPopUp, 0)
			end
			State.HasDoubleJumped = false
			if State.ActiveMode == "WebZipping" then
