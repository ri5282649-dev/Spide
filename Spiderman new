	end)
end

local function playSound(soundName, basePitch, pitchVariance)
	local s = Sounds[soundName]
	if not s then
		return
	end
	local pitch = (basePitch or 1.0) + ((math.random() * 2 - 1) * (pitchVariance or 0.08))
	s.PlaybackSpeed = clamp(pitch, 0.5, 2.0)
	pcall(function()
		s:Play()
	end)
end

