local function resetTargetTransforms()
	for k, _ in pairs(TargetTransforms) do
		TargetTransforms[k] = IDENTITY_CF
	end
end

local function stepProceduralPose(dt)
	if not Character or not RootPart or not Humanoid then
		return
	end
	resetTargetTransforms()
	local now = os.clock()

	-- 1. WEB ZIP (100% Procedural 3-Phase Pose)
	if State.IsWebZipping then
		local elapsed = now - State.ZipStartTime
		local alpha = clamp(elapsed / State.ZipDuration, 0, 1)
		local isRight = (State.ZipWrist == "Right")

		if alpha < 0.28 then
			TargetTransforms.Waist = CFrame.Angles(math.rad(-25), math.rad(isRight and -18 or 18), 0)
			TargetTransforms.Neck = CFrame.Angles(math.rad(22), 0, 0)
			if isRight then
				TargetTransforms.RightShoulder = CFrame.Angles(math.rad(155), math.rad(10), math.rad(8))
				TargetTransforms.RightElbow = CFrame.Angles(math.rad(10), 0, 0)
				TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(-40), 0, math.rad(-25))
			else
				TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(155), math.rad(-10), math.rad(-8))
				TargetTransforms.LeftElbow = CFrame.Angles(math.rad(10), 0, 0)
				TargetTransforms.RightShoulder = CFrame.Angles(math.rad(-40), 0, math.rad(25))
			end
		elseif alpha < 0.78 then
			TargetTransforms.Root = CFrame.Angles(math.rad(-48), 0, 0)
			TargetTransforms.Waist = CFrame.Angles(math.rad(-18), 0, 0)
			TargetTransforms.Neck = CFrame.Angles(math.rad(42), 0, 0)
			TargetTransforms.RightShoulder = CFrame.Angles(math.rad(130), 0, math.rad(18))
			TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(130), 0, math.rad(-18))
			TargetTransforms.RightHip = CFrame.Angles(math.rad(58), 0, math.rad(6))
			TargetTransforms.RightKnee = CFrame.Angles(math.rad(-85), 0, 0)
			TargetTransforms.LeftHip = CFrame.Angles(math.rad(38), 0, math.rad(-6))
			TargetTransforms.LeftKnee = CFrame.Angles(math.rad(-65), 0, 0)
		else
			TargetTransforms.Root = CFrame.Angles(math.rad(18), 0, 0)
			TargetTransforms.RightShoulder = CFrame.Angles(math.rad(45), 0, math.rad(45))
			TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(45), 0, math.rad(-45))
			TargetTransforms.RightHip = CFrame.Angles(math.rad(35), 0, 0)
			TargetTransforms.LeftHip = CFrame.Angles(math.rad(35), 0, 0)
		end

	-- 2. WEB HANGING (uses rbxassetid://125903067740797; procedural fallback if track not loaded)
	elseif State.IsHanging then
		local hangTrackActive = AnimationTracks.Hang
			and AnimationTracks.Hang.IsPlaying
			and AnimationTracks.Hang.Length > 0

		if not hangTrackActive then
			local sway = math.sin(now * 2.1) * 4
			TargetTransforms.Root = CFrame.Angles(0, 0, math.rad(180 + sway))
			TargetTransforms.Waist = CFrame.Angles(math.rad(8), 0, 0)
			TargetTransforms.Neck = CFrame.Angles(math.rad(-18), math.rad(math.sin(now * 1.4) * 14), 0)
			TargetTransforms.RightShoulder = CFrame.Angles(math.rad(35), 0, math.rad(22))
			TargetTransforms.RightElbow = CFrame.Angles(math.rad(55), 0, 0)
			TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(25), 0, math.rad(-22))
			TargetTransforms.LeftElbow = CFrame.Angles(math.rad(45), 0, 0)
			TargetTransforms.RightHip = CFrame.Angles(math.rad(48), 0, math.rad(12))
			TargetTransforms.RightKnee = CFrame.Angles(math.rad(-75), 0, 0)
			TargetTransforms.LeftHip = CFrame.Angles(math.rad(18), 0, math.rad(-8))
			TargetTransforms.LeftKnee = CFrame.Angles(math.rad(-35), 0, 0)
		end

	-- 3. WEB WINGS GLIDING
	elseif State.IsGliding then
		TargetTransforms.Waist = CFrame.Angles(math.rad(-12), 0, 0)
		TargetTransforms.Neck = CFrame.Angles(math.rad(52), 0, 0)
		TargetTransforms.RightShoulder = CFrame.Angles(math.rad(15), 0, math.rad(82))
		TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(15), 0, math.rad(-82))
		TargetTransforms.RightHip = CFrame.Angles(math.rad(-12), 0, math.rad(14))
		TargetTransforms.LeftHip = CFrame.Angles(math.rad(-12), 0, math.rad(-14))

	-- 4. WEB SHIELDING
	elseif State.IsShielding then
		TargetTransforms.Waist = CFrame.Angles(math.rad(-10), math.rad(28), 0)
		TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(92), math.rad(35), math.rad(-20))
		TargetTransforms.LeftElbow = CFrame.Angles(math.rad(68), 0, 0)
		TargetTransforms.RightShoulder = CFrame.Angles(math.rad(35), 0, math.rad(22))
		TargetTransforms.RightElbow = CFrame.Angles(math.rad(55), 0, 0)

	-- 5. SUPERHERO 3-POINT LANDING
	elseif State.IsSuperheroLanding then
		TargetTransforms.Root = CFrame.new(0, -1.15, 0) * CFrame.Angles(math.rad(-32), math.rad(18), 0)
		TargetTransforms.Waist = CFrame.Angles(math.rad(-28), math.rad(-15), 0)
		TargetTransforms.Neck = CFrame.Angles(math.rad(38), math.rad(12), 0)
		TargetTransforms.RightShoulder = CFrame.Angles(math.rad(65), 0, math.rad(-12))
		TargetTransforms.RightElbow = CFrame.Angles(math.rad(25), 0, 0)
		TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(-42), 0, math.rad(-38))
		TargetTransforms.RightHip = CFrame.Angles(math.rad(78), 0, math.rad(12))
		TargetTransforms.RightKnee = CFrame.Angles(math.rad(-105), 0, 0)
		TargetTransforms.LeftHip = CFrame.Angles(math.rad(-42), 0, math.rad(-12))
		TargetTransforms.LeftKnee = CFrame.Angles(math.rad(-85), 0, 0)

	-- 6. SUPER JUMP CROUCH CHARGE
	elseif State.IsChargingJump and Humanoid.FloorMaterial ~= Enum.Material.Air then
		local a = State.JumpChargeAlpha
		TargetTransforms.Root = CFrame.new(0, -0.85 * a, 0) * CFrame.Angles(math.rad(-24 * a), 0, 0)
		TargetTransforms.Neck = CFrame.Angles(math.rad(28 * a), 0, 0)
		TargetTransforms.RightShoulder = CFrame.Angles(math.rad(-48 * a), 0, math.rad(22 * a))
		TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(-48 * a), 0, math.rad(-22 * a))
		TargetTransforms.RightHip = CFrame.Angles(math.rad(65 * a), 0, math.rad(12 * a))
		TargetTransforms.RightKnee = CFrame.Angles(math.rad(-90 * a), 0, 0)
		TargetTransforms.LeftHip = CFrame.Angles(math.rad(65 * a), 0, math.rad(-12 * a))
		TargetTransforms.LeftKnee = CFrame.Angles(math.rad(-90 * a), 0, 0)

	-- 7. AERIAL FLIP / DODGE (uses rbxassetid://6881270464; procedural fallback if not loaded)
	elseif State.IsFlipping or State.IsDodging then
		local flipTrackActive = AnimationTracks.Flip
			and AnimationTracks.Flip.IsPlaying
			and AnimationTracks.Flip.Length > 0

		if not flipTrackActive then
			local a = clamp((now - State.FlipStartTime) / State.FlipDuration, 0, 1)
			local spinAngle = a * math.pi * 2
			TargetTransforms.Root = CFrame.Angles(-spinAngle, 0, 0)
			TargetTransforms.RightHip = CFrame.Angles(math.rad(72), 0, 0)
			TargetTransforms.RightKnee = CFrame.Angles(math.rad(-95), 0, 0)
			TargetTransforms.LeftHip = CFrame.Angles(math.rad(72), 0, 0)
			TargetTransforms.LeftKnee = CFrame.Angles(math.rad(-95), 0, 0)
		end

	-- 8. 5-HIT MARTIAL ARTS COMBAT COMBO
	elseif State.IsAttacking then
		local idx = State.ComboIndex
		if idx == 1 then
			TargetTransforms.Waist = CFrame.Angles(0, math.rad(-38), 0)
			TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(92), 0, math.rad(-12))
			TargetTransforms.RightShoulder = CFrame.Angles(math.rad(45), 0, math.rad(22))
			TargetTransforms.RightElbow = CFrame.Angles(math.rad(75), 0, 0)
		elseif idx == 2 then
			TargetTransforms.Waist = CFrame.Angles(math.rad(-10), math.rad(46), 0)
			TargetTransforms.RightShoulder = CFrame.Angles(math.rad(95), 0, math.rad(12))
			TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(45), 0, math.rad(-22))
			TargetTransforms.LeftElbow = CFrame.Angles(math.rad(75), 0, 0)
		elseif idx == 3 then
			TargetTransforms.Root = CFrame.new(0, -0.55, 0) * CFrame.Angles(math.rad(18), math.rad(-45), 0)
			TargetTransforms.RightHip = CFrame.Angles(math.rad(85), 0, math.rad(35))
			TargetTransforms.LeftHip = CFrame.Angles(math.rad(55), 0, math.rad(-20))
			TargetTransforms.LeftKnee = CFrame.Angles(math.rad(-75), 0, 0)
		elseif idx == 4 then
			local a = clamp((now - State.AttackStartTime) / State.AttackDuration, 0, 1)
			TargetTransforms.Root = CFrame.Angles(0, a * math.pi * 2, math.rad(18))
			TargetTransforms.LeftHip = CFrame.Angles(math.rad(92), 0, math.rad(-42))
		else
			local flipTrackActive = AnimationTracks.Flip
				and AnimationTracks.Flip.IsPlaying
				and AnimationTracks.Flip.Length > 0
			if not flipTrackActive then
				local a = clamp((now - State.AttackStartTime) / State.AttackDuration, 0, 1)
				TargetTransforms.Root = CFrame.Angles(a * math.pi * 2, 0, 0)
				TargetTransforms.RightHip = CFrame.Angles(math.rad(110), 0, 0)
				TargetTransforms.LeftHip = CFrame.Angles(math.rad(-35), 0, 0)
			end
		end

	-- 9. WEB PULL HEAVE POSE
	elseif State.IsPulling then
		TargetTransforms.Waist = CFrame.Angles(math.rad(24), 0, 0)
		TargetTransforms.RightShoulder = CFrame.Angles(math.rad(115), 0, math.rad(15))
		TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(115), 0, math.rad(-15))

	-- 10. SWINGING PROCEDURAL FALLBACK (only if swing track hasn't loaded)
	elseif State.IsSwinging then
		local swingTrackActive = AnimationTracks.Swing
			and AnimationTracks.Swing.IsPlaying
			and AnimationTracks.Swing.Length > 0
		if not swingTrackActive then
			local isRight = (State.SwingWrist == "Right")
			TargetTransforms.Waist = CFrame.Angles(math.rad(-15), math.rad(isRight and -15 or 15), 0)
			if isRight then
				TargetTransforms.RightShoulder = CFrame.Angles(math.rad(148), 0, math.rad(12))
				TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(-32), 0, math.rad(-25))
			else
				TargetTransforms.LeftShoulder = CFrame.Angles(math.rad(148), 0, math.rad(-12))
				TargetTransforms.RightShoulder = CFrame.Angles(math.rad(-32), 0, math.rad(25))
			end
			TargetTransforms.RightHip = CFrame.Angles(math.rad(48), 0, math.rad(8))
			TargetTransforms.RightKnee = CFrame.Angles(math.rad(-68), 0, 0)
			TargetTransforms.LeftHip = CFrame.Angles(math.rad(22), 0, math.rad(-8))
			TargetTransforms.LeftKnee = CFrame.Angles(math.rad(-35), 0, 0)
		end
	end

	-- Smoothly blend and apply procedural transforms on Motor6D.Transform
	local blendAlpha = clamp(dt * 18, 0, 1)
	for jointName, motor in pairs(Motors) do
		if motor and motor.Parent then
			local targetCF = TargetTransforms[jointName] or IDENTITY_CF
			local currentCF = CurrentTransforms[jointName] or IDENTITY_CF
			local nextCF = currentCF:Lerp(targetCF, blendAlpha)
			CurrentTransforms[jointName] = nextCF
			if nextCF ~= IDENTITY_CF then
				motor.Transform = nextCF
			end
		end
	end
end

--==============================================================================
-- 20. CAMERA FOV, BANKING, SPRINT & HUD UPDATE LOOP
--==============================================================================

local function stepCameraAndHUD(dt)
	Camera = Workspace.CurrentCamera or Camera
	if not RootPart or not Humanoid or not Camera then
		return
	end

	local vel = RootPart.AssemblyLinearVelocity
	local speed = vel.Magnitude

	-- 1. Regenerate Web Fluid when not draining
	if not State.IsSwinging and not State.IsShielding then
		State.WebFluid = clamp(State.WebFluid + CONFIG.WebFluid.RegenRate * dt, 0, CONFIG.WebFluid.Max)
	end

	-- 2. Walk Speed Manager (Base / Sprint / Shield) — restores automatically
	if not State.IsSwinging and not State.IsCrawling and not State.IsHanging and not State.IsGliding then
		local targetWalk = CONFIG.Strength.BaseWalkSpeed
		if State.IsShielding then
			targetWalk = 14
		elseif State.IsSprinting then
			targetWalk = CONFIG.Strength.SprintWalkSpeed
		end
		if Humanoid.WalkSpeed ~= targetWalk then
			Humanoid.WalkSpeed = targetWalk
		end
	end

	-- 3. Super Jump Charge Bar Progression
	if State.IsChargingJump then
		local chargeTime = os.clock() - State.JumpChargeStart
		State.JumpChargeAlpha = clamp(chargeTime / CONFIG.Strength.SuperJumpMaxChargeTime, 0, 1)
		if JumpChargeFill then
			JumpChargeFill.Size = UDim2.new(State.JumpChargeAlpha, 0, 1, 0)
		end
	end

	-- 4. Superhero Hard-Landing Detection
	if Humanoid.FloorMaterial == Enum.Material.Air then
		State.LastVerticalVelocity = vel.Y
	else
		if
			State.LastVerticalVelocity < CONFIG.Strength.HardLandingVelocity
			and not State.IsSuperheroLanding
			and not State.IsSwinging
			and not State.IsCrawling
		then
			State.IsSuperheroLanding = true
			playSound("Impact", 0.9, 0.05)
			spawnShockwaveRing(
				RootPart.Position - Vector3.new(0, 2.5, 0),
				Vector3.new(0, 1, 0),
				11.0,
				Color3.fromRGB(245, 248, 255),
				0.38
			)
			task.delay(0.45, function()
				State.IsSuperheroLanding = false
			end)
		end
		State.LastVerticalVelocity = 0
		State.HasDoubleJumped = false
	end

	-- 5. Speed Wind Particles & Looped Wind Audio
	if SpeedWindEmitter then
		SpeedWindEmitter.Rate = speed > 44 and clamp((speed - 44) * 1.4, 12, 105) or 0
	end
	if Sounds.AirWind then
		local targetWindVol = speed > 36 and clamp((speed - 36) / 95, 0, 0.55) or 0
		Sounds.AirWind.Volume = lerp(Sounds.AirWind.Volume, targetWindVol, clamp(dt * 6, 0, 1))
	end

	-- 6. Dynamic Camera FOV & Swing Roll
	local speedAlpha = clamp((speed - 24) / 105, 0, 1)
	local targetFOV = lerp(CONFIG.Camera.BaseFOV, CONFIG.Camera.MaxFOV, speedAlpha)
	State.CurrentFOV = lerp(State.CurrentFOV, targetFOV, clamp(dt * CONFIG.Camera.LerpSpeed, 0, 1))
	Camera.FieldOfView = State.CurrentFOV

	local targetRoll = 0
	if State.IsSwinging or State.IsGliding then
		local lateralVel = vel:Dot(Camera.CFrame.RightVector)
		targetRoll = clamp(-lateralVel * 0.15, -CONFIG.Camera.MaxRollDegrees, CONFIG.Camera.MaxRollDegrees)
	end
	State.CurrentRoll = lerp(State.CurrentRoll, targetRoll, clamp(dt * 9, 0, 1))
	if math.abs(State.CurrentRoll) > 0.05 then
		Camera.CFrame = Camera.CFrame * CFrame.Angles(0, 0, math.rad(State.CurrentRoll))
	end

	-- 7. HUD Fluid Bar, Mode Badge, Speedometer & Crosshair
	if FluidFillFrame and FluidPercentLabel then
		local pct = State.WebFluid / CONFIG.WebFluid.Max
		FluidFillFrame.Size = UDim2.new(pct, 0, 1, 0)
		FluidPercentLabel.Text = string.format("%d%%", math.floor(pct * 100 + 0.5))
	end
	if StateBadgeLabel then
		StateBadgeLabel.Text = "STATE: " .. string.upper(State.ActiveMode)
	end
	if SpeedMeterLabel then
		SpeedMeterLabel.Text = string.format("%d SPS", math.floor(speed + 0.5))
	end

	if CrosshairStatusLabel and CrosshairRing then
		local anchorPos, isFreeAir = getCachedSwingAnchor()
		local ringStroke = CrosshairRing:FindFirstChild("RingStroke")
		if anchorPos and not isFreeAir then
			CrosshairStatusLabel.Text = "BUILDING LOCK"
			CrosshairStatusLabel.TextColor3 = Color3.fromRGB(115, 255, 160)
			if ringStroke then
				ringStroke.Color = Color3.fromRGB(115, 255, 160)
			end
		elseif anchorPos and isFreeAir then
			CrosshairStatusLabel.Text = "FREE SWING READY"
			CrosshairStatusLabel.TextColor3 = Color3.fromRGB(120, 210, 255)
			if ringStroke then
				ringStroke.Color = Color3.fromRGB(120, 210, 255)
			end
		else
			CrosshairStatusLabel.Text = "NO ANCHOR"
			CrosshairStatusLabel.TextColor3 = Color3.fromRGB(255, 110, 110)
			if ringStroke then
				ringStroke.Color = Color3.fromRGB(255, 110, 110)
			end
		end
	end
end

