		WingsMaid:Give(torsoLeft)
		WingsMaid:Give(torsoRight)
		WingsMaid:Give(armLeft)
		WingsMaid:Give(armRight)

		local wingL = createWebTextureBeam(torsoLeft, armLeft, 1.35, 0.45, Color3.fromRGB(210, 235, 255))
		local wingR = createWebTextureBeam(torsoRight, armRight, 1.35, 0.45, Color3.fromRGB(210, 235, 255))
		WingsMaid:Give(wingL)
		WingsMaid:Give(wingR)
