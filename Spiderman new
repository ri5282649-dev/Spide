local function getRayParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = Character and { Character } or {}
	params.IgnoreWater = true
	return params
end

local function getDesiredSwingHorizontalDirection()
	if not RootPart or not Camera then
		return Vector3.new(0, 0, -1)
	end
	local camLook = Camera.CFrame.LookVector
	local camFlat = safeUnit(Vector3.new(camLook.X, 0, camLook.Z), RootPart.CFrame.LookVector)
	local moveDir = Humanoid and Humanoid.MoveDirection or Vector3.zero
	local vel = RootPart.AssemblyLinearVelocity
	local flatVel = Vector3.new(vel.X, 0, vel.Z)

	if moveDir.Magnitude > 0.1 then
		if flatVel.Magnitude > 20 then
			return safeUnit(moveDir.Unit * 0.6 + flatVel.Unit * 0.4, camFlat)
		end
		return safeUnit(moveDir, camFlat)
	elseif flatVel.Magnitude > 15 then
		return safeUnit(flatVel.Unit * 0.55 + camFlat * 0.45, camFlat)
	end
	return camFlat
end

local function findBestSwingAnchor()
	if not RootPart or not Camera then
		return nil, false
	end

	local params = getRayParams()
	local camCF = Camera.CFrame
	local rootPos = RootPart.Position
	local maxDist = CONFIG.Swing.MaxRayDistance
	local desiredDir = getDesiredSwingHorizontalDirection()
	local vel = RootPart.AssemblyLinearVelocity
	local flatSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local leadDist = clamp(
		CONFIG.Swing.FreeAirForwardOffset + flatSpeed * CONFIG.Swing.FreeAirSpeedLeadFactor,
		45,
		130
	)

	-- 1. Direct camera raycast biased upward (must lead ahead so the web never yanks backward)
	local primaryDir = safeUnit(camCF.LookVector + Vector3.new(0, 0.25, 0))
	local directHit = Workspace:Raycast(camCF.Position, primaryDir * maxDist, params)
	if directHit and directHit.Position.Y >= rootPos.Y + CONFIG.Swing.MinAnchorHeightAbovePlayer then
		local flatTo = Vector3.new(directHit.Position.X - rootPos.X, 0, directHit.Position.Z - rootPos.Z)
		if flatTo:Dot(desiredDir) > 8 then
			return directHit.Position, false
		end
	end

	-- 2. Cone fan search oriented along the desired travel direction
	local bestPoint = nil
	local bestScore = -math.huge
	local basis = CFrame.lookAt(rootPos, rootPos + desiredDir, Vector3.new(0, 1, 0))
	local pitchAngles = { 20, 32, 44, 56 }
	local yawAngles = { 0, -14, 14, -28, 28, -42, 42 }

	for _, pitchDeg in ipairs(pitchAngles) do
		for _, yawDeg in ipairs(yawAngles) do
			local dir = (basis * CFrame.Angles(math.rad(pitchDeg), math.rad(yawDeg), 0)).LookVector
			local result = Workspace:Raycast(rootPos + Vector3.new(0, 2, 0), dir * maxDist, params)
			if result and result.Position.Y >= rootPos.Y + CONFIG.Swing.MinAnchorHeightAbovePlayer then
				local toAnchor = result.Position - rootPos
				local dist = toAnchor.Magnitude
				if dist >= CONFIG.Swing.MinRopeLength and dist <= maxDist then
					local flatTo = Vector3.new(toAnchor.X, 0, toAnchor.Z)
					local forwardProj = flatTo:Dot(desiredDir)
					if forwardProj > 10 then
						local alignDot = safeUnit(flatTo):Dot(desiredDir)
						local heightBonus = (result.Position.Y - rootPos.Y) * 0.5
						local leadScore = -math.abs(forwardProj - leadDist) * 0.4
						local score = alignDot * 65 + heightBonus + leadScore
						if score > bestScore then
							bestScore = score
							bestPoint = result.Position
						end
					end
				end
			end
		end
	end

	if bestPoint then
		return bestPoint, false
	end

	-- 3. Dynamic velocity-leading free-air sky anchor when no buildings exist
	if CONFIG.Swing.AllowFreeAirSwing then
		local skyAnchor = rootPos
			+ desiredDir * leadDist
			+ Vector3.new(0, CONFIG.Swing.FreeAirUpwardOffset, 0)
		return skyAnchor, true
	end

	return nil, false
end

-- Throttled cache used by the per-frame crosshair HUD (prevents 29 raycasts/frame)
local cachedAnchorPos = nil
local cachedAnchorFreeAir = false
local lastAnchorScanTime = 0

local function getCachedSwingAnchor()
	local now = os.clock()
	if now - lastAnchorScanTime >= 0.12 then
		lastAnchorScanTime = now
		cachedAnchorPos, cachedAnchorFreeAir = findBestSwingAnchor()
	end
	return cachedAnchorPos, cachedAnchorFreeAir
end

local function findAimTarget(maxRange)
	if not Camera or not RootPart then
		return RootPart and RootPart.Position or Vector3.new(0, 0, 0), Vector3.new(0, 1, 0), nil
	end
	local params = getRayParams()
	local camCF = Camera.CFrame
	local hit = Workspace:Raycast(camCF.Position, camCF.LookVector * maxRange, params)
	if hit then
		return hit.Position, hit.Normal, hit.Instance
	end
	local fallbackPos = RootPart.Position + camCF.LookVector * (maxRange * 0.65)
	return fallbackPos, -camCF.LookVector, nil
end

