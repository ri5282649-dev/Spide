local function throwWebBomb()
	if not RootPart or not Humanoid or Humanoid.Health <= 0 or not Camera then
		return
	end
	local now = os.clock()
	if now - State.LastWebBombTime < CONFIG.WebBomb.Cooldown then
		return
	end
	if not consumeWebFluid(CONFIG.WebFluid.WebBombCost) then
		return
	end

	State.LastWebBombTime = now
	updateButtonHighlight("WebBomb", true)
	task.delay(0.3, function()
		updateButtonHighlight("WebBomb", false)
	end)

	playSound("WebShootAlt", 0.88, 0.05)
	playSound("Whoosh", 1.0, 0.05)

	local startPos = RootPart.Position + Vector3.new(0, 2.2, 0) + Camera.CFrame.LookVector * 2
	local velocity = Camera.CFrame.LookVector * CONFIG.WebBomb.ThrowSpeed + Vector3.new(0, 22, 0)

	local bomb = Instance.new("Part")
	bomb.Name = "SpiderWebBomb"
	bomb.Shape = Enum.PartType.Ball
	bomb.Size = Vector3.new(1.1, 1.1, 1.1)
	bomb.Material = Enum.Material.Neon
	bomb.Color = Color3.fromRGB(240, 248, 255)
	bomb.Anchored = true
	bomb.CanCollide = false
	bomb.CanQuery = false
	bomb.CanTouch = false
	bomb.Position = startPos
	bomb.Parent = Workspace

	local core = Instance.new("Part")
	core.Name = "BombCore"
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(0.55, 0.55, 0.55)
	core.Material = Enum.Material.Neon
	core.Color = Color3.fromRGB(235, 45, 55)
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.Position = startPos
	core.Parent = bomb

	local params = getRayParams()
	local currentPos = startPos
	local elapsed = 0
	local conn

	local function detonate(detPos, detNormal)
		if conn then
			conn:Disconnect()
		end
		if bomb.Parent then
			bomb:Destroy()
		end

		playSound("Impact", 0.92, 0.06)
		playSound("WebShoot", 0.78, 0.05)
		spawnRadialWebSplat(detPos, detNormal, 7.5, 7.0)
		spawnShockwaveRing(detPos, detNormal, CONFIG.WebBomb.BlastRadius, Color3.fromRGB(240, 248, 255), 0.45)

		local dome = Instance.new("Part")
		dome.Shape = Enum.PartType.Ball
		dome.Size = Vector3.new(2, 2, 2)
		dome.Material = Enum.Material.ForceField
		dome.Color = Color3.fromRGB(235, 245, 255)
		dome.Transparency = 0.25
		dome.Anchored = true
		dome.CanCollide = false
		dome.CanQuery = false
		dome.CanTouch = false
		dome.Position = detPos
		dome.Parent = Workspace

		TweenService:Create(
			dome,
			TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{
				Size = Vector3.new(
					CONFIG.WebBomb.BlastRadius * 1.8,
					CONFIG.WebBomb.BlastRadius * 1.8,
					CONFIG.WebBomb.BlastRadius * 1.8
				),
				Transparency = 1,
			}
		):Play()
		Debris:AddItem(dome, 0.48)

		local centerAtt = Instance.new("Attachment")
		centerAtt.WorldPosition = detPos
		centerAtt.Parent = Workspace.Terrain
		Debris:AddItem(centerAtt, 2.6)

		for i = 1, 16 do
			local theta = (i / 16) * math.pi * 2
			local phi = (i % 3 - 1) * 0.45
			local rayDir = Vector3.new(
				math.cos(theta) * math.cos(phi),
				math.sin(phi) + 0.2,
				math.sin(theta) * math.cos(phi)
			).Unit
			local rayHit = Workspace:Raycast(detPos, rayDir * CONFIG.WebBomb.BlastRadius, params)
			local endPos = rayHit and rayHit.Position or (detPos + rayDir * (CONFIG.WebBomb.BlastRadius * 0.7))

			local endAtt = Instance.new("Attachment")
			endAtt.WorldPosition = endPos
			endAtt.Parent = Workspace.Terrain
			Debris:AddItem(endAtt, 2.5)

			local strand = createWebTextureBeam(centerAtt, endAtt, 0.18, 0.28)
			Debris:AddItem(strand, 2.5)
		end

		local overlapParams = OverlapParams.new()
		overlapParams.FilterType = Enum.RaycastFilterType.Exclude
		overlapParams.FilterDescendantsInstances = Character and { Character } or {}
		local parts = Workspace:GetPartBoundsInRadius(detPos, CONFIG.WebBomb.BlastRadius, overlapParams)
		local processedModels = {}

		for _, p in ipairs(parts) do
			if not p.Anchored then
				local pushDir = safeUnit(p.Position - detPos, Vector3.new(0, 1, 0))
				pcall(function()
					p.AssemblyLinearVelocity = pushDir * 32 + Vector3.new(0, 18, 0)
				end)
			end
			local model = p:FindFirstAncestorOfClass("Model")
			if model and not processedModels[model] then
				processedModels[model] = true
				local npcHum = model:FindFirstChildOfClass("Humanoid")
				local npcRoot = model:FindFirstChild("HumanoidRootPart")
				if npcHum and npcRoot then
					local cocoon = Instance.new("Part")
					cocoon.Name = "SpiderWebCocoon"
					cocoon.Shape = Enum.PartType.Ball
					cocoon.Size = Vector3.new(4.8, 5.8, 4.8)
					cocoon.Material = Enum.Material.ForceField
					cocoon.Color = Color3.fromRGB(245, 250, 255)
					cocoon.Transparency = 0.2
					cocoon.CanCollide = false
					cocoon.CanQuery = false
					cocoon.CanTouch = false
					cocoon.Massless = true
					cocoon.Parent = model

					local w = Instance.new("Weld")
					w.Part0 = npcRoot
					w.Part1 = cocoon
					w.Parent = cocoon
					Debris:AddItem(cocoon, CONFIG.WebBomb.SnareDuration)
				end
			end
		end
	end

	conn = RunService.Heartbeat:Connect(function(dt)
		elapsed = elapsed + dt
		velocity = velocity - Vector3.new(0, CONFIG.WebBomb.Gravity * dt, 0)
		local stepVec = velocity * dt
		local hit = Workspace:Raycast(currentPos, stepVec, params)
		if hit or elapsed > 2.4 then
			detonate(hit and hit.Position or currentPos, hit and hit.Normal or Vector3.new(0, 1, 0))
			return
		end
		currentPos = currentPos + stepVec
		bomb.Position = currentPos
		core.Position = currentPos
	end)
end

