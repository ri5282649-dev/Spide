					hit.Instance:ApplyImpulseAtPosition(
						dir * hit.Instance.AssemblyMass * CONFIG.WebShoot.ImpulseStrength,
						hit.Position
					)
				end)
			end
			return
		end
		currentPos = currentPos + dir * stepDist
		traveled = traveled + stepDist
		proj.CFrame = CFrame.lookAt(currentPos, currentPos + dir)
		if traveled >= CONFIG.WebShoot.MaxRange then
			conn:Disconnect()
			proj:Destroy()
		end
	end)
