-- 22. CHARACTER BINDING, R15 MOTOR6D DISCOVERY & LIFECYCLE
--==============================================================================

local function loadCharacterAnimations()
	AnimationTracks.Swing = nil
	AnimationTracks.Crawl = nil
	AnimationTracks.Hang = nil
	AnimationTracks.Flip = nil
	if not Animator then
		return
	end

	local function loadTrack(animId, priority, looped)
		local anim = Instance.new("Animation")
		anim.AnimationId = animId
		CharacterMaid:Give(anim)
		local ok, track = pcall(function()
			return Animator:LoadAnimation(anim)
		end)
		if ok and track then
			track.Priority = priority
			track.Looped = looped
			return track
		end
		warn("[SpiderManSystem] Failed to load animation: " .. tostring(animId))
		return nil
	end

	AnimationTracks.Swing = loadTrack(CONFIG.Animations.WEB_SWING, Enum.AnimationPriority.Action3, true)
	AnimationTracks.Crawl = loadTrack(CONFIG.Animations.WALL_CRAWL, Enum.AnimationPriority.Action2, true)
	AnimationTracks.Hang = loadTrack(CONFIG.Animations.WEB_HANG, Enum.AnimationPriority.Action3, true)
	AnimationTracks.Flip = loadTrack(CONFIG.Animations.FLIP, Enum.AnimationPriority.Action4, false)
end

local function cacheR15Motors(char)
	Motors = {}
	local motorNames = {
		"Root",
		"Waist",
		"Neck",
		"RightShoulder",
		"RightElbow",
		"RightWrist",
		"LeftShoulder",
		"LeftElbow",
		"LeftWrist",
		"RightHip",
		"RightKnee",
		"RightAnkle",
		"LeftHip",
		"LeftKnee",
		"LeftAnkle",
	}
	local nameSet = {}
	for _, n in ipairs(motorNames) do
		nameSet[n] = true
	end

	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("Motor6D") and nameSet[desc.Name] then
			Motors[desc.Name] = desc
		end
	end
end

local function setupCharacter(newChar)
	cancelAllAbilities()
	CharacterMaid:Clean()

	Character = newChar
	Humanoid = newChar:WaitForChild("Humanoid", 10)
	RootPart = newChar:WaitForChild("HumanoidRootPart", 10)
	if not Humanoid or not RootPart then
		warn("[SpiderManSystem] Character setup failed: Humanoid/RootPart missing")
		return
	end

	local animatorChild = Humanoid:FindFirstChildOfClass("Animator")
	if not animatorChild then
		animatorChild = Instance.new("Animator")
		animatorChild.Parent = Humanoid
	end
	Animator = animatorChild

	Head = newChar:WaitForChild("Head", 5)
	UpperTorso = newChar:FindFirstChild("UpperTorso")
	LeftHand = newChar:FindFirstChild("LeftHand")
	RightHand = newChar:FindFirstChild("RightHand")
	LeftLowerArm = newChar:FindFirstChild("LeftLowerArm")
	RightLowerArm = newChar:FindFirstChild("RightLowerArm")

	Humanoid.WalkSpeed = CONFIG.Strength.BaseWalkSpeed
	Humanoid.UseJumpPower = true
	Humanoid.JumpPower = CONFIG.Strength.BaseJumpPower
	State.WebFluid = CONFIG.WebFluid.Max
	State.ActiveMode = "Normal"
	State.IsSprinting = false

	cacheR15Motors(newChar)
	pcall(loadCharacterAnimations)
	pcall(setupSounds)
	pcall(createWristWebShooters)
	pcall(createSpiderSenseCrown)
	pcall(createSpeedWindParticles)
	pcall(buildHUD)

	CharacterMaid:Give(Humanoid.Died:Connect(function()
		cancelAllAbilities()
	end))

	print("[SpiderManSystem] Character bound — all systems online.")
end

if LocalPlayer.Character then
	task.spawn(setupCharacter, LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupCharacter)

