local function stepWebWings(dt)
	if not State.IsGliding or not RootPart or not Humanoid or not Camera then
		return
	end
	if Humanoid.FloorMaterial ~= Enum.Material.Air then
		stopWebWings()
		return
	end

	local camLook = Camera.CFrame.LookVector
	local pitchFactor = -camLook.Y
	State.GlideSpeed = clamp(
		State.GlideSpeed + pitchFactor * 38 * dt,
		CONFIG.WebWings.MinGlideSpeed,
		CONFIG.WebWings.MaxGlideSpeed
	)

	local glideVel = Vector3.new(camLook.X, math.min(camLook.Y, -0.12), camLook.Z).Unit * State.GlideSpeed
		- Vector3.new(0, CONFIG.WebWings.SinkRate * 0.25, 0)

	if State.GlideLinearVel then
		State.GlideLinearVel.VectorVelocity = glideVel
	end
	if State.GlideAlign then
		State.GlideAlign.CFrame = CFrame.lookAt(RootPart.Position, RootPart.Position + glideVel)
			* CFrame.Angles(math.rad(-75), 0, 0)
	end
end

--==============================================================================
-- 17. SYSTEM 8 — 5-HIT PROCEDURAL ACROBATIC COMBAT COMBO
--==============================================================================

local function performCombatCombo()
	if not RootPart or not Humanoid or Humanoid.Health <= 0 then
		return
	end
	local now = os.clock()
	if now - State.LastAttackTime < CONFIG.Combat.HitCooldown then
		return
	end
	if State.IsSwinging or State.IsCrawling or State.IsHanging or State.IsGliding then
		return
	end

	if now - State.LastAttackTime > CONFIG.Combat.ComboResetTime then
		State.ComboIndex = 1
	else
		State.ComboIndex = (State.ComboIndex % 5) + 1
	end

	State.LastAttackTime = now
	State.AttackStartTime = now
	State.IsAttacking = true
	State.AttackDuration = (State.ComboIndex == 5) and 0.48 or 0.32
	updateButtonHighlight("Combat", true)

	playSound("Swoosh", 0.95 + State.ComboIndex * 0.06, 0.05)

	local lungeVec = RootPart.CFrame.LookVector * CONFIG.Combat.LungeSpeed
	if State.ComboIndex == 5 then
		lungeVec = lungeVec + Vector3.new(0, 28, 0)
		playFlipAnimation(0.48)
	end
	RootPart.AssemblyLinearVelocity = Vector3.new(
		lungeVec.X,
		RootPart.AssemblyLinearVelocity.Y + lungeVec.Y,
		lungeVec.Z
	)

	local hitCenter = RootPart.Position + RootPart.CFrame.LookVector * 4.8
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = Character and { Character } or {}
	local hitParts = Workspace:GetPartBoundsInRadius(hitCenter, CONFIG.Combat.HitRange * 0.55, overlap)

	local hitAnything = false
	for _, p in ipairs(hitParts) do
		if not p.Anchored then
			hitAnything = true
			pcall(function()
				p.AssemblyLinearVelocity = RootPart.CFrame.LookVector * CONFIG.Combat.KnockbackImpulse
					+ Vector3.new(0, 22, 0)
			end)
		end
	end

	if hitAnything or State.ComboIndex == 5 then
		playSound("Impact", 1.05, 0.08)
		spawnShockwaveRing(
			hitCenter,
			RootPart.CFrame.LookVector,
			State.ComboIndex == 5 and 7.5 or 4.2,
			Color3.fromRGB(255, 90, 95),
			0.24
		)
	end

	local capturedAttackTime = now
	task.delay(State.AttackDuration, function()
		if State.AttackStartTime == capturedAttackTime then
			State.IsAttacking = false
			updateButtonHighlight("Combat", false)
		end
	end)
end

