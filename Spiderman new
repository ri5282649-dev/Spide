stopWebHang = function()
	if not State.IsHanging then
		return
	end
	State.IsHanging = false
	HangMaid:Clean()
	State.HangRope = nil
	State.HangAlign = nil

	if AnimationTracks.Hang and AnimationTracks.Hang.IsPlaying then
		AnimationTracks.Hang:Stop(0.22)
	end

	if Humanoid then
		Humanoid.AutoRotate = true
		Humanoid.PlatformStand = false
	end
	if State.ActiveMode == "Hanging" then
		State.ActiveMode = "Normal"
	end
	updateButtonHighlight("WebHang", false)
end

local function toggleWebHang()
	if State.IsHanging then
		stopWebHang()
		return
	end
	if not RootPart or not Humanoid or Humanoid.Health <= 0 then
		return
	end
	if not consumeWebFluid(CONFIG.WebFluid.WebHangCost) then
		return
	end

	if State.IsSwinging then
		stopWebSwing(false)
	end
	if State.IsCrawling then
		stopCrawl(false)
	end
	if State.IsGliding then
		stopWebWings()
	end

	local overheadHit = Workspace:Raycast(RootPart.Position, Vector3.new(0, 145, 0), getRayParams())
	local anchorPos = overheadHit and overheadHit.Position or (RootPart.Position + Vector3.new(0, 48, 0))

	State.IsHanging = true
	State.ActiveMode = "Hanging"
	State.HangAnchorPos = anchorPos

	playSound("WebShoot", 1.04, 0.05)
	if overheadHit then
		spawnRadialWebSplat(anchorPos, overheadHit.Normal, 2.2, 6.0)
	end

	local worldAtt = Instance.new("Attachment")
	worldAtt.WorldPosition = anchorPos
	worldAtt.Parent = Workspace.Terrain
	HangMaid:Give(worldAtt)

	local rootAtt = Instance.new("Attachment")
	rootAtt.Position = Vector3.new(0, 1.5, 0)
	rootAtt.Parent = RootPart
	HangMaid:Give(rootAtt)

	local dist = clamp((anchorPos - RootPart.Position).Magnitude, 10, 130)
	local rope = Instance.new("RopeConstraint")
	rope.Attachment0 = rootAtt
	rope.Attachment1 = worldAtt
	rope.Length = dist
	rope.Restitution = 0.05
	rope.Enabled = true
	rope.Parent = RootPart
	HangMaid:Give(rope)
	State.HangRope = rope

	local align = Instance.new("AlignOrientation")
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = rootAtt
	align.Responsiveness = 18
	align.MaxTorque = 90000
	align.CFrame = RootPart.CFrame
	align.Parent = RootPart
	HangMaid:Give(align)
	State.HangAlign = align

	local beam = createWebTextureBeam(rootAtt, worldAtt, 0.14, 0.18)
	HangMaid:Give(beam)

	Humanoid.AutoRotate = false
	RootPart.AssemblyLinearVelocity = RootPart.AssemblyLinearVelocity * 0.25

	if AnimationTracks.Hang then
		AnimationTracks.Hang:Play(0.22, 1, 1.0)
	end

	updateButtonHighlight("WebHang", true)
end

local function stepWebHang(dt)
	if not State.IsHanging or not RootPart or not State.HangRope or not State.HangAlign or not Camera then
		return
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		State.HangRope.Length = math.max(8, State.HangRope.Length - 22 * dt)
	elseif UserInputService:IsKeyDown(Enum.KeyCode.S) then
		State.HangRope.Length = math.min(135, State.HangRope.Length + 22 * dt)
	end

	local camLook = Camera.CFrame.LookVector
	local flatLook = safeUnit(Vector3.new(camLook.X, 0, camLook.Z), Vector3.new(0, 0, -1))
	State.HangAlign.CFrame = CFrame.lookAt(RootPart.Position, RootPart.Position + flatLook, Vector3.new(0, 1, 0))
end

